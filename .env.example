# Скопируйте этот файл в .env (рядом с bot.py) и заполните значения.
# .env в git не попадает (см. .gitignore).

# 1. Токен бота из Telegram: @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# 2. Ключ DeepSeek: platform.deepseek.com -> API keys
DEEPSEEK_API_KEY=sk-example-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 3. Supabase: Project Settings -> API Keys
#    URL проекта и ключ доступа к базе. Нужен secret-ключ (Supabase → API Keys →
#    «Publishable and secret API keys» → Secret keys → sb_secret_...) — он для сервера,
#    в браузер и чаты его не кладут: ключ открывает всю базу.
SUPABASE_URL=https://example.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
#    Legacy-ключ service_role (eyJ...) тоже принимается — прежняя переменная ниже.
SUPABASE_SERVICE_KEY=
#    В каких заголовках уходит ключ: apikey (по умолчанию — так требует Supabase для
#    ключей нового формата) или both (apikey + Authorization: Bearer). Второй нужен
#    нестандартным шлюзам/self-hosted: если база отвечает «permission denied for schema
#    public» (42501), посмотрите вывод `python bot.py --check` — он проверяет оба варианта.
SUPABASE_KEY_HEADER=apikey
#    Сколько раз повторить запрос к базе при сетевом сбое (таймаут ответа, обрыв связи):
#    по умолчанию 2 — то есть до трёх попыток подряд; 0 — не повторять. Обычная вставка
#    (новый долг) не повторяется никогда, чтобы не задвоить запись: бот скажет об ошибке.
SUPABASE_RETRIES=2

# 4. Валюты и доступ
DEFAULT_CURRENCY=BYN
# Пусто = бот отвечает всем; иначе — только этим Telegram user id (через запятую)
ALLOWED_USER_IDS=
# Пароль чата: бот просит его, когда его добавляют в чат, и работает только там,
# где пароль введён верно (/password <пароль> или просто сообщением). Пусто — без пароля.
CHAT_PASSWORD=

# 5. Курсы валют (ExchangeRate-API) — для команды /d и отчёта /rates
#    Ключ бесплатный: регистрация на app.exchangerate-api.com → Dashboard → API Key.
#    Без ключа бот работает через открытый эндпоинт open.er-api.com (лимит запросов
#    и обязательна ссылка на exchangerate-api.com).
RATES_API_KEY=
RATES_API_URL=https://v6.exchangerate-api.com/v6
RATES_OPEN_URL=https://open.er-api.com/v6
# Базовая валюта, к которой приводятся курсы
RATES_BASE=BYN
# Какие валюты хранить: бел. рубль, рос. рубль, доллар, евро, юань, тайский бат
RATES_CURRENCIES=BYN,RUB,USD,EUR,CNY,THB
# Во сколько по Минску бот сам подтягивает курсы (раз в день, 0–23). По умолчанию 12:00.
RATES_HOUR=12

# 6. Как бот реагирует в группах
#    REQUIRE_MENTION=1 (по умолчанию): только на обращение — «@ваш_бот Леша должен Диме 3»,
#    «/debts@ваш_бот» или ответ на сообщение бота. В личке отвечает всегда.
#    REQUIRE_MENTION=0: бот разбирает любое сообщение в группе (нужно отключить privacy mode
#    у @BotFather: /setprivacy → Disable).
REQUIRE_MENTION=1
# Имя бота без @ — подсказка на случай, если getMe недоступен (обычно можно не задавать)
BOT_USERNAME=

# 7. Прочее
#    REQUEST_TIMEOUT — таймаут запросов к Telegram/DeepSeek/Supabase, секунды (минимум 5)
REQUEST_TIMEOUT=30
LOG_LEVEL=INFO

# 8. Режим вебхука — нужен только на хостингах без постоянного процесса
#    (Vercel, PythonAnywhere, любой WSGI). Секрет, которым Telegram подписывает
#    запросы; допустимы только A-Z, a-z, 0-9, «_», «-» (до 256 символов).
#    Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
